# 자체 호스팅(사내 서버) 배포용 환경변수 템플릿.
#   cp .env.selfhost.example .env
# 로 복사한 뒤 값을 채우고 `docker compose up -d --build`를 실행하면 된다.
# 그 한 줄이 postgres → migrate(스키마·기본값 적용) → app 순으로 올린다.
# 호스트에 psql이나 node를 따로 설치할 필요는 없다 — 전부 컨테이너 안에 있다.
#
# 다만 그 뒤에 사람이 해야 하는 일이 두 가지 남는다. 안 하면 시스템을 쓸 수 없다:
#   1) 첫 관리자 지정 — 새 DB에는 관리자가 0명이다. 웹에서 가입한 뒤
#      `./ops/make-admin.sh 본인이메일@회사.com`을 한 번 실행한다.
#   2) 부서별 행동지침 입력 — 시드가 없다. 비워 두면 특보가 떠도 지침 없는
#      메시지가 나간다. 대시보드 셋업 체크리스트를 끝까지 진행한다.
# 전체 절차와 장애 대응은 docs/운영.md 에 있다. 처음이면 그 문서부터 보라.
#
# .env는 gitignore 대상이다 — 실제 값이 저장소에 들어가지 않는다.
# 비밀번호는 `openssl rand -hex 24`로 만든다(영문·숫자만 나와 URL에 안전하다).

# --- 데이터베이스 ---
# postgres 컨테이너가 초기화될 때 슈퍼유저(postgres)에게 부여하는 비밀번호.
# 최초 1회 볼륨(pgdata)을 만들 때만 반영된다.
POSTGRES_PASSWORD=여기에_긴_임의문자열

# db/migrations/0010_role_login.sql이 app_user / app_service 역할에 부여하는 비밀번호.
# docker-compose.yml의 app 서비스가 이 값으로 접속 문자열을 조립한다.
# URL에 그대로 들어가므로 영문·숫자만 쓰는 편이 안전하다.
APP_USER_PASSWORD=여기에_긴_임의문자열
APP_SERVICE_PASSWORD=여기에_긴_임의문자열

# 호스트에서 psql로 데이터베이스에 직접 붙을 때만 쓰는 슈퍼유저 접속.
# 컨테이너로 운영할 때는 쓰이지 않는다 — 마이그레이션은 compose의 migrate
# 서비스가 컨테이너 네트워크 안에서(postgres:5432) 알아서 적용한다.
# 127.0.0.1:5433은 docker-compose.yml이 호스트로 내보낸 포트다.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/weather

# --- 앱 ---
# 가입을 허용할 이메일 도메인(콤마로 여러 개). 사내 DNS로만 닿는다는 전제를
# 코드로 한 번 더 못박는 값이다.
ALLOWED_EMAIL_DOMAINS=gonjiam.com

# 카카오워크 DM에 넣는 딥링크의 기준 주소. 사내에서 실제로 접속하는 주소를 적는다.
APP_BASE_URL=http://weather.사내주소:8080

# 기상청 공공데이터포털(data.go.kr) 단기예보 조회서비스 일반 인증키(Decoding).
KMA_API_KEY=공공데이터포털_일반인증키_Decoding

# 카카오워크 봇 앱키. 비워 두면 발송이 로그로만 나간다(설치 직후 점검용).
#
# 이 값이 없으면 발송만 막히는 것이 아니다: 서버가 **회사 이메일로 카카오워크
# 사용자 id를 찾아 직원 행에 채우는 일**도 못 한다. 그 값이 비어 있는 직원에게는
# 특보 승인 요청·재알림·점검 알림이 전부 나가지 않는다. 키를 나중에 넣어도 되지만
# (매일 새벽 5시 20분에 미연결 직원을 다시 찾는다), 넣기 전까지는 대시보드
# 셋업 체크리스트의 "카카오워크 연결"이 미완료로 남고 /api/health/deep이 503이다.
KAKAOWORK_BOT_KEY=카카오워크_봇_앱키

# console로 두면 카카오워크 대신 로그 채널로 발송한다. 운영에서는 비워 둔다.
NOTIFY_CHANNEL=

# HTTPS로 서비스할 때만 true. http로 접속하는데 true면 세션 쿠키가 아예 안 내려가
# 로그인이 되지 않는다.
COOKIE_SECURE=false

# --- 포트 (필요할 때만) ---
# 다른 프로그램이 이미 그 포트를 쓰고 있을 때만 바꾼다. docker-compose.yml을 직접
# 고치면 다음 git pull에서 충돌하므로 여기서 바꾼다. 값을 바꾼 뒤에는
# `docker compose up -d`를 실행해야 반영된다.
# APP_HOST_PORT=8090          # 웹 화면 주소가 http://서버주소:8090 이 된다
# POSTGRES_HOST_PORT=5443     # 호스트에서 psql로 붙을 때 쓰는 포트
