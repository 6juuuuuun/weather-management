# 자체 호스팅(사내 서버) 배포용 환경변수 템플릿.
#   cp .env.selfhost.example .env
# 로 복사한 뒤 값을 채우고 `docker compose up -d --build` 한 줄이면 전체가 뜬다.
# .env는 gitignore 대상이다 — 실제 값이 저장소에 들어가지 않는다.

# --- 데이터베이스 ---
# postgres 컨테이너가 초기화될 때 슈퍼유저(postgres)에게 부여하는 비밀번호.
# 최초 1회 볼륨(pgdata)을 만들 때만 반영된다.
POSTGRES_PASSWORD=여기에_긴_임의문자열

# db/migrations/0010_role_login.sql이 app_user / app_service 역할에 부여하는 비밀번호.
# docker-compose.yml의 app 서비스가 이 값으로 접속 문자열을 조립한다.
# URL에 그대로 들어가므로 영문·숫자만 쓰는 편이 안전하다.
APP_USER_PASSWORD=여기에_긴_임의문자열
APP_SERVICE_PASSWORD=여기에_긴_임의문자열

# 마이그레이션 적용(`cd db && npm run migrate`)에만 쓰는 슈퍼유저 접속.
# 호스트에서 psql로 붙으므로 127.0.0.1:5433(docker-compose.yml의 포트 매핑)이다.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/weather

# --- 앱 ---
# 가입을 허용할 이메일 도메인(콤마로 여러 개). 사내 DNS로만 닿는다는 전제를
# 코드로 한 번 더 못박는 값이다.
ALLOWED_EMAIL_DOMAINS=gonjiam.com

# 카카오워크 DM에 넣는 딥링크의 기준 주소. 사내에서 실제로 접속하는 주소를 적는다.
APP_BASE_URL=http://weather.사내주소:8080

# 기상청 공공데이터포털(data.go.kr) 단기예보 조회서비스 일반 인증키(Decoding).
KMA_API_KEY=공공데이터포털_일반인증키_Decoding

# 카카오워크 봇 앱키. 비워 두면 발송이 로그로만 나간다(설치 직후 점검용).
KAKAOWORK_BOT_KEY=카카오워크_봇_앱키

# console로 두면 카카오워크 대신 로그 채널로 발송한다. 운영에서는 비워 둔다.
NOTIFY_CHANNEL=

# HTTPS로 서비스할 때만 true. http로 접속하는데 true면 세션 쿠키가 아예 안 내려가
# 로그인이 되지 않는다.
COOKIE_SECURE=false
