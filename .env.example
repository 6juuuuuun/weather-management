# 개발·테스트용 환경변수 템플릿 (저장소 루트).
#   cp .env.example .env
# 로 복사한 뒤 값을 채운다. .env는 gitignore 대상이다.
#
# 운영 서버에 올릴 때 볼 파일은 이쪽이 아니라 `.env.selfhost.example`이다
# (그리고 절차는 docs/운영.md). 이 파일은 "개발자가 로컬에서 server 테스트를
# 돌릴 때" 쓰는 값이다 — server/vitest.config.ts가 이 .env를 직접 읽어
# process.env에 채운다.
#
# Supabase 값(VITE_SUPABASE_*, SUPABASE_SERVICE_ROLE_KEY)과 CRON_SECRET은
# 자체 호스팅 이관으로 전부 죽어서 지웠다. 앱은 이제 Postgres에 직접 붙고,
# 주기 작업은 pg_cron이 아니라 서버 프로세스 안(jobs/scheduler.ts)에서 돈다.

# --- 로컬 Postgres (docker-compose.yml의 postgres 서비스) ---
# postgres 컨테이너가 초기화될 때 슈퍼유저에게 부여하는 비밀번호.
# 최초 1회 볼륨(pgdata)을 만들 때만 반영된다.
POSTGRES_PASSWORD=<random string>
# db/migrations/0010_role_login.sql이 app_user/app_service 역할에 부여하는 로그인 비밀번호.
# 마이그레이션 파일에는 절대 적지 않고, ops/migrate.sh가 -v로 psql에 전달한다.
# URL에 그대로 들어가므로 영문·숫자만 쓴다(`openssl rand -hex 24`).
APP_USER_PASSWORD=<random string>
APP_SERVICE_PASSWORD=<random string>

# server/src/db.ts의 withUser/withService가 각각 접속에 쓰는 커넥션 문자열.
# 정책이 적용되는 접속과 우회하는 접속을 아예 다른 커넥션으로 갈라 둔다 — 위 두 비밀번호로 조립.
# 127.0.0.1:5433은 docker-compose.yml이 호스트로 내보낸 포트다(컨테이너 안에서는 postgres:5432).
DATABASE_URL_USER=postgres://app_user:<APP_USER_PASSWORD>@127.0.0.1:5433/weather
DATABASE_URL_SERVICE=postgres://app_service:<APP_SERVICE_PASSWORD>@127.0.0.1:5433/weather
# 호스트에서 psql로 직접 붙을 때 쓰는 슈퍼유저 접속(위 POSTGRES_PASSWORD로 조립).
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/weather

# --- 앱 ---
# server/src/auth/routes.ts의 가입 라우트가 이 도메인만 허용한다(콤마로 여러 개 가능).
ALLOWED_EMAIL_DOMAINS=gonjiam.com
# 특보 문자에 넣는 링크의 기준 주소.
APP_BASE_URL=http://localhost:8080
# 기상청 공공데이터포털 (data.go.kr, 단기예보 조회서비스 일반 인증키 Decoding).
KMA_API_KEY=<decoding key>
# 문자(SMS/LMS) 발송 제공자 이름. **지금은 비워 둔다** — 붙일 제공자가 아직 없다.
# 비어 있으면 모든 발송이 앱 로그로만 나가고 /api/health/deep이 503과 함께
# "SMS 발송 설정이 아직 없습니다 — 인프라 연동 대기 중"을 돌려준다.
# 제공자가 정해지면 server/src/shared/sms.ts의 getChannel에 구현을 추가하고
# 여기에 그 이름을 적는다(그 파일 맨 위에 어디를 고치는지 적혀 있다).
SMS_PROVIDER=
# HTTPS로 서비스할 때만 true. 로컬 http 개발에서 true로 두면 세션 쿠키가 내려가지 않는다.
COOKIE_SECURE=false

# --- 포트 (필요할 때만) ---
# 다른 프로그램이 이미 그 포트를 쓰고 있을 때만 바꾼다. docker-compose.yml을 직접
# 고치면 다음 git pull에서 충돌하므로 여기서 바꾼다. 값을 바꾼 뒤에는
# `docker compose up -d`를 실행해야 반영된다.
# APP_HOST_PORT=8090          # 웹 화면 주소가 http://서버주소:8090 이 된다
# POSTGRES_HOST_PORT=5443     # 호스트에서 psql로 붙을 때 쓰는 포트
