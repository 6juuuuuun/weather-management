# --- Supabase (supabase start 출력값 / 프로덕션은 대시보드에서) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# --- 기상청 공공데이터포털 (data.go.kr, 단기예보 조회서비스 일반 인증키) ---
KMA_API_KEY=<decoding key>
# --- 카카오워크 봇 (워크스페이스 관리자 콘솔에서 발급) --- 로그인 멤버십 조회·DM 발송·특보 발송에 모두 사용
KAKAOWORK_BOT_KEY=<bot app key>
# 최초 시스템 관리자의 카카오워크 계정 이메일
ADMIN_KAKAOWORK_ID=admin@company.com
# pg_cron → edge function 호출 인증용 임의 랜덤 문자열
CRON_SECRET=<random string>
# 웹 콘솔 URL (매직링크 딥링크 생성용)
APP_BASE_URL=http://localhost:5173
# (선택) console로 두면 카카오워크 대신 로그 채널로 발송 — 개발/시연용. 프로덕션에선 비워 둡니다.
NOTIFY_CHANNEL=
# --- 자체 호스팅 Postgres (docker-compose.yml / db/migrations, self-hosted 이관) ---
# docker-compose.yml의 postgres 서비스가 초기화 시 쓰는 슈퍼유저 비밀번호.
POSTGRES_PASSWORD=<random string>
# db/migrations/0010_role_login.sql이 app_user/app_service 역할에 부여하는 로그인 비밀번호.
# 마이그레이션 파일에는 절대 적지 않고, db/package.json의 migrate 스크립트가
# -v로 psql에 전달한다.
APP_USER_PASSWORD=<random string>
APP_SERVICE_PASSWORD=<random string>
# server/src/db.ts의 withUser/withService가 각각 접속에 쓰는 커넥션 문자열.
# 정책이 적용되는 접속과 우회하는 접속을 아예 다른 커넥션으로 갈라 둔다 — 위 두 비밀번호로 조립.
DATABASE_URL_USER=postgres://app_user:<APP_USER_PASSWORD>@127.0.0.1:5433/weather
DATABASE_URL_SERVICE=postgres://app_service:<APP_SERVICE_PASSWORD>@127.0.0.1:5433/weather
# db/package.json의 migrate 스크립트가 마이그레이션 적용에 쓰는 슈퍼유저 접속(위 POSTGRES_PASSWORD로 조립).
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/weather
# server/src/auth/routes.ts의 가입 라우트가 이 도메인만 허용한다(콤마로 여러 개 가능).
ALLOWED_EMAIL_DOMAINS=gonjiam.com
# HTTPS로 서비스할 때만 true. 로컬 http 개발에서 true로 두면 세션 쿠키가 내려가지 않는다.
COOKIE_SECURE=false
# 로컬 테스트용 값 템플릿은 `.env.test.example`을 참고하세요 (cp .env.test.example .env.test).
