# 로컬 테스트 전용 환경변수 템플릿 — `cp .env.test.example .env.test` 후 사용하세요.
# .env.test 자체는 gitignore 대상입니다(실제 키가 섞일 수 있으므로).
#
# 아래 SUPABASE_* 값은 `supabase start` / `supabase status`가 출력하는 로컬 스택의
# 공개된 데모 키입니다. 로컬 전용이며 프로덕션 값이 아닙니다.

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

# pg_cron → Edge Function 호출 인증용. 테스트 스크립트 기본값과 맞춰 둡니다.
CRON_SECRET="test-secret"

# console = 카카오워크 대신 로그로 출력 (봇 키 없이 전 구간 테스트 가능)
NOTIFY_CHANNEL="console"

# 딥링크 생성용 웹 콘솔 URL
APP_BASE_URL="http://localhost:5173"

# 카카오워크 OAuth를 건너뛰는 테스트 전용 mock 프로필.
# auth-kakaowork는 SUPABASE_URL이 127.0.0.1/localhost일 때만 이 값을 인정하므로
# 프로덕션에 잘못 설정돼도 무시되지만, 그래도 프로덕션 secrets에는 넣지 마세요.
MOCK_KAKAO_PROFILE={"email":"new@t.co","user_id":"kw-new","name":"신규"}

# 이 이메일로 로그인하면 시스템관리자(admin)가 됩니다 (auth-kakaowork 통합 테스트가 사용).
ADMIN_KAKAOWORK_ID="boss@t.co"
